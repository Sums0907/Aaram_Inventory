# AaramInventory Production Environment Template
# ---------------------------------------------

# IMPORTANT: The DATABASE_URL must point to the Host's Docker Bridge IP (typically 172.17.0.1 or 172.18.0.1), NOT localhost!
# If AaramIdentity uses 172.17.0.1, use the same here.
DATABASE_URL="postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@172.17.0.1:5432/inventory_prod"

# AaramIdentity Authentication Config
# The URL must be the public Identity API for JWT validation if applicable, 
# or the internal URL depending on how the backend connects.
AUTH_MODE="aaramidentity"
AARAMIDENTITY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n[PASTE_KEY_HERE]\n-----END PUBLIC KEY-----"

# Logging & App Environment
ENVIRONMENT="production"
